# Server Configuration
NODE_ENV=development
PORT=5000

# MongoDB Configuration
# Local MongoDB (alternative)
# MONGODB_URI=mongodb://localhost:27017/ani-digital

# MongoDB Atlas (recommended)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.ccnp9l0.mongodb.net/ani-digital?retryWrites=true&w=majority&appName=Cluster0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRE=7d

# CORS Configuration
CLIENT_URL=http://localhost:8080

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_PATH=uploads/

# WeatherAPI.com Configuration
# Get your free API key from https://www.weatherapi.com/
WEATHER_API_KEY=your-weatherapi-key
